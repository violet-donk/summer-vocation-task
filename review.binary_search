#include <stdio.h>
int binarySearch(int arr[], int n, int key)
{
    int left = 0;
    int right = n - 1;
    while(left <= right)
    {
        int mid = (left + right) / 2;
        if(arr[mid] == key)
            return mid;
        else if(arr[mid] < key)
            left = mid + 1;
        else
            right = mid - 1;
    }
    return -1;
}

int main(void)
{
    int arr[] = {10,20,30,40,50,60,70};
    int len = sizeof(arr)/sizeof(arr[0]);
    int target = 40;
    int pos = binarySearch(arr, len, target);
    if(pos != -1)
        printf("元素%d，下标为：%d\n", target, pos);
    else
        printf("未找到该元素\n");
    return 0;
}
