#include<iostream>
#include<vector>
using namespace std;
int main() {
	int n;
	cin >> n;
	vector<int>dp;
	for(int i = 0; i < n; i++) {
		int x;
		cin >> x;
		dp.push_back(x);
	}
	for (int i = 0; i < n; i++) {
		for (int j = 0; j < n - 1; j++) {
			if (dp[i] < dp[j]) {
				int temp = dp[i];
				dp[i] = dp[j];
				dp[j] = temp;
			}
		}
	}
	for (int x : dp) {
		cout << x << " ";
	}
}
